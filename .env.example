# Copy to .env.local and fill in. Never commit real secrets.

# ── Site ────────────────────────────────────────────────────────────
# Public URL used for canonical links, sitemap, OG/JSON-LD absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Payments (Razorpay) ─────────────────────────────────────────────
# From dashboard.razorpay.com → Settings → API Keys. Use test keys first.
# When unset: online payment runs in demo mode in development and is
# disabled in production (COD still works).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret for payment.captured / payment.failed events (recommended).
RAZORPAY_WEBHOOK_SECRET=
# Allow demo "payments" in a production build (staging/preview only!).
ALLOW_DEMO_PAYMENTS=false

# ── Database (orders, newsletter, accounts) ─────────────────────────
# Postgres connection string, e.g. from Supabase or Neon.
DATABASE_URL=

# ── Auth ────────────────────────────────────────────────────────────
# Setting this opens /admin and /dashboard (they 404 until then).
AUTH_SECRET=

# ── Email ───────────────────────────────────────────────────────────
# Transactional email (order confirmations) + newsletter audience.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
EMAIL_FROM="Ahara <orders@yourdomain.com>"
